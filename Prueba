      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Grafica de $f(x)=e^{x^2}$ y $P(x)=1+x^2+\\frac{x^4}{3!}$\n"
      ],
      "metadata": {
        "id": "3V2sTJgayvXN"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def p(x):\n",
        "  return 1+x**2+(x**4)/2"
      ],
      "metadata": {
        "id": "I6b325xi07mm"
      },
      "execution_count": 7,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def f(x):\n",
        "  return np.exp(x**2)"
      ],
      "metadata": {
        "id": "49K3uXBYzaUY"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "xx=np.linspace(0,1,100)\n",
        "plt.plot(xx,f(xx),color= 'red')\n",
        "plt.plot(xx,p(xx))\n"
      ],
